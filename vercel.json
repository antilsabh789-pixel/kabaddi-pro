{
  "version": 2,
  "installCommand": "corepack enable pnpm && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/kabaddi-pro run build",
  "outputDirectory": "artifacts/kabaddi-pro/dist/public",
  "framework": null,
  "env": {
    "BASE_PATH": "/",
    "PORT": "3000",
    "NODE_ENV": "production"
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
