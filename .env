# ─── Database Configuration ─────────────────────────────────
# Local dev: SQLite (file:./db/custom.db)
# Vercel prod: PostgreSQL (set DATABASE_URL in Vercel dashboard)
DATABASE_URL=file:./db/custom.db

# ─── Production Database (PostgreSQL for Vercel) ─────────────
# Set these in Vercel Environment Variables instead of here
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# ─── OTP Provider Configuration ─────────────────────────────────
# Real SMS provider only: msg91 | twilio
# NO demo mode - OTP is always sent via real SMS
OTP_PROVIDER=msg91

# ─── MSG91 Configuration ────────────────────────────────────────
# Sign up at https://msg91.com
# 1. Create account & verify email
# 2. Get Auth Key from: Dashboard → API Keys
# 3. Create OTP Template: SendOTP → Templates → Create
#    Use {{OTP}} variable in template for the OTP code
# 4. Create Sender ID (DLT registered) for India SMS delivery
# 5. Add SMS credits to your account (required for delivery!)
# Pricing: ~₹0.30-0.50 per SMS | 50 free SMS on signup
MSG91_AUTH_KEY=528840AMmrbUJi0U4b6a2e3858P1
MSG91_TEMPLATE_ID=6a2e3af8cda93304790f2f32
MSG91_SENDER_ID=KPAPPS

# ─── Twilio Configuration (optional alternative) ────────────────
# Sign up at https://twilio.com
# Option A: Twilio Verify (recommended)
#   1. Create Verify Service: Verify → Services → Create
#   2. Set TWILIO_VERIFY_SERVICE_SID
# Option B: Direct SMS
#   1. Buy a phone number
#   2. Set TWILIO_PHONE_NUMBER
# Pricing: ~₹0.70-1.00 per SMS | $15 free trial credit
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
