# ─── Database Configuration ─────────────────────────────────
# Local dev: SQLite (file:./db/custom.db)
# Vercel prod: PostgreSQL (set DATABASE_URL in Vercel dashboard)
DATABASE_URL=file:./db/custom.db

# ─── Production Database (PostgreSQL for Vercel) ─────────────
# Set these in Vercel Environment Variables instead of here
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# ─── OTP Provider Configuration ─────────────────────────────────
# Mode: auto | fast2sms | msg91 | twilio
# "auto" = tries all available providers in order: Fast2SMS → MSG91 → Twilio
# Add FAST2SMS_API_KEY for the most reliable delivery in India (no DLT needed)
OTP_PROVIDER=auto

# ─── Fast2SMS Configuration (RECOMMENDED) ────────────────────────
# Sign up at https://fast2sms.com (₹50 free credits!)
# Get API key from: Dashboard → Dev API
# No DLT registration required - instant delivery
FAST2SMS_API_KEY=

# ─── MSG91 Configuration (requires DLT registration) ─────────────
# MSG91 requires DLT Entity ID + Sender ID + Template + PE-TM Chain
# Without DLT, API returns "success" but SMS is NEVER delivered
MSG91_AUTH_KEY=528840AMmrbUJi0U4b6a2e3858P1
MSG91_TEMPLATE_ID=

# ─── Twilio Configuration (RECOMMENDED - Most Reliable!) ────────────────
# Sign up at https://twilio.com (free trial with $15+ credits!)
#
# OPTION A: Twilio Verify (BEST for OTP - no phone number needed!)
#   1. Go to https://www.twilio.com/console/verify/services
#   2. Click "Create Service" → Name it "Kabaddi Pro"
#   3. Copy the Service SID (starts with "VA...")
#   4. Set TWILIO_VERIFY_SERVICE_SID below
#   - No DLT registration needed for India!
#   - Works with ALL Indian carriers
#   - Built-in rate limiting and fraud guard
#   - Handles OTP verification server-side
#
# OPTION B: Direct SMS (fallback - needs a Twilio phone number)
#   1. Buy a phone number from Twilio Console
#   2. Set TWILIO_PHONE_NUMBER below (E.164 format, e.g., +1234567890)
#   - For India: Twilio numbers can't send to Indian numbers directly
#   - Recommended: Use Twilio Verify instead
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
